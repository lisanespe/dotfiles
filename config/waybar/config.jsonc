{
    "layer": "top",
    "position": "top",
    "height": 33,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": [
        "tray",
        "keyboard-state",
        "group/hw-cpu",
        "group/hw-gpu",
        "memory",
        "network",
        "bluetooth",
        "pulseaudio"
    ],

    // CPU and GPU usage + temperature share one pill each
    "group/hw-cpu": {
        "orientation": "horizontal",
        "modules": ["cpu", "custom/cpu-temp"]
    },

    "group/hw-gpu": {
        "orientation": "horizontal",
        "modules": ["custom/gpu-usage", "custom/gpu-temp"]
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true
        
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 50,
        "separate-outputs": true
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "keyboard-state": {
        "numlock": false, // no numpad on this keyboard
        "capslock": true,
        "device-path": "/dev/input/by-id/usb-MosArt_USB_Keyboard-event-kbd",
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "󰌾 ",
            "unlocked": " "
        }
    },

    "clock": {
        "format": "󰥔 {:%H:%M  %d/%m/%Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>"
    },

    "cpu": {
        "interval": 2,
        "format": "{icon} {usage}%",
        "tooltip": true,
        "format-icons": ["󰻠"]
    },

    "custom/cpu-temp": {
    	"exec": "t=$(sensors -u k10temp-pci-00c3 | awk '/^  temp1_input:/ {printf \"%.0f\", $2}'); cls=\"\"; [ \"$t\" -ge 85 ] && cls=\"critical\"; printf '{\"text\":\"%s\",\"class\":\"%s\"}\\n' \"$t\" \"$cls\"",
        "return-type": "json",
        "format": "󰔏 {}°C",
        "interval": 2,
        "tooltip": false
    },

    "custom/gpu-usage": {
        "exec": "cat /sys/class/drm/card1/device/gpu_busy_percent",
        "format": "󰢮 {}%",
        "interval": 2,
        "tooltip": false
    },

    "custom/gpu-temp": {
        "exec": "t=$(sensors -u amdgpu-pci-0900 | awk '/^  temp1_input:/ {printf \"%.0f\", $2; exit}'); cls=\"\"; [ \"$t\" -ge 90 ] && cls=\"critical\"; printf '{\"text\":\"%s\",\"class\":\"%s\"}\\n' \"$t\" \"$cls\"",
        "return-type": "json",
        "format": "󰔏 {}°C",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "interval": 5,
        "format": "󰍛 {used:0.1f}G/{total:0.1f}G"
    },

    "network": {
        "format-wifi": "󰖩 {essid} ({signalStrength}%)",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰖪 Disconnected",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-connected": "󰂱 {device_alias}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{device_enumerate}",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰸈 muted",
        "format-icons": {
            "headphone": "",
            "headset": "󰋎",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    }
}
