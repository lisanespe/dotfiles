{
    "layer": "top",
    "position": "top",
    "height": 33,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock", "mpris"],
    "modules-right": [
        "custom/updates",
        "idle_inhibitor",
        "tray",
        "keyboard-state",
        "group/hw-cpu",
        "group/hw-gpu",
        "memory",
        "network",
        "bluetooth",
        "pulseaudio",
        "custom/power"
    ],

    // CPU and GPU usage + temperature share one pill each
    "group/hw-cpu": {
        "orientation": "horizontal",
        "modules": ["cpu", "custom/cpu-temp"]
    },

    "group/hw-gpu": {
        "orientation": "horizontal",
        "modules": ["custom/gpu-usage", "custom/gpu-temp"]
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true
        
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 50,
        "separate-outputs": true
    },

    // Pending pacman repo updates; hidden when there are none.
    // Click runs pacman -Syu, then signal 8 refreshes the count.
    "custom/updates": {
        "exec": "~/.config/waybar/scripts/updates.sh",
        "return-type": "json",
        "format": "󰇚 {}",
        "interval": 1800,
        "signal": 8,
        "on-click": "kitty -e sh -c 'sudo pacman -Syu; pkill -RTMIN+8 waybar'",
        "on-click-right": "pkill -RTMIN+8 waybar"
    },

    // Power button: wofi menu with lock, suspend, logout, reboot, shutdown
    "custom/power": {
        "format": "󰐥",
        "tooltip-format": "Power menu",
        "on-click": "~/.config/waybar/scripts/powermenu.sh"
    },

    // Click to keep the screen awake (blocks hypridle lock / screen off)
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated": "Staying awake",
        "tooltip-format-deactivated": "Idle lock on"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "keyboard-state": {
        "numlock": false, // no numpad on this keyboard
        "capslock": true,
        "device-path": "/dev/input/by-id/usb-MosArt_USB_Keyboard-event-kbd",
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "󰌾 ",
            "unlocked": " "
        }
    },

    "clock": {
        "format": "󰥔 {:%H:%M  %d/%m/%Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>"
    },

    // Now playing (Spotify, Firefox, ...); hidden when no player is active.
    // Click play/pause, right click next, middle click previous.
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "dynamic-order": ["title", "artist"],
        "dynamic-len": 40,
        "player-icons": {
            "default": "󰎆",
            "spotify": "󰓇",
            "firefox": "󰈹"
        },
        "status-icons": {
            "paused": "󰏤"
        },
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },

    "cpu": {
        "interval": 2,
        "format": "{icon} {usage}%",
        "tooltip": true,
        "format-icons": ["󰻠"]
    },

    "custom/cpu-temp": {
    	"exec": "t=$(sensors -u k10temp-pci-00c3 | awk '/^  temp1_input:/ {printf \"%.0f\", $2}'); cls=\"\"; [ \"$t\" -ge 85 ] && cls=\"critical\"; printf '{\"text\":\"%s\",\"class\":\"%s\"}\\n' \"$t\" \"$cls\"",
        "return-type": "json",
        "format": "󰔏 {}°C",
        "interval": 2,
        "tooltip": false
    },

    "custom/gpu-usage": {
        "exec": "cat /sys/class/drm/card1/device/gpu_busy_percent",
        "format": "󰢮 {}%",
        "interval": 2,
        "tooltip": false
    },

    "custom/gpu-temp": {
        "exec": "t=$(sensors -u amdgpu-pci-0900 | awk '/^  temp1_input:/ {printf \"%.0f\", $2; exit}'); cls=\"\"; [ \"$t\" -ge 90 ] && cls=\"critical\"; printf '{\"text\":\"%s\",\"class\":\"%s\"}\\n' \"$t\" \"$cls\"",
        "return-type": "json",
        "format": "󰔏 {}°C",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "interval": 5,
        "format": "󰍛 {used:0.1f}G/{total:0.1f}G"
    },

    "network": {
        "format-wifi": "󰖩 {essid} ({signalStrength}%)",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰖪 Disconnected",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-connected": "󰂱 {device_alias}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{device_enumerate}",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰸈 muted",
        "format-icons": {
            "headphone": "",
            "headset": "󰋎",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    }
}
