[Unit]
Description=Jellyfin Media Server
After=local-fs.target network-online.target
RequiresMountsFor=/mnt/data

[Container]
Image=docker.io/jellyfin/jellyfin:10.11.8
ContainerName=myjellyfin
Network=host

Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=America/Argentina/Buenos_Aires

Volume=%h/jellyfin/config:/config
Volume=%h/jellyfin/cache:/cache
Volume=/mnt/data:/media:ro

AddDevice=/dev/dri/renderD128

[Service]
Restart=always
# User units cannot wait for system mounts (RequiresMountsFor= is ignored here).
# Refuse to start without /mnt/data, else the bind mount captures an empty dir.
ExecStartPre=/usr/bin/mountpoint -q /mnt/data
RestartSec=30

[Install]
WantedBy=default.target
